{
  "_comment": "DGX / full-size evals (Llama 3.1 8B, Qwen 3.5 9B, CodeLlama 7B). Dense then 4:8 sparsify per model so the checkpoint load is reused. Do not use for Mac iterate.",
  "model": "hf",
  "batch_size": "auto:4",
  "runs": [
    {
      "name": "llama31_ceval_dense",
      "model_args": "pretrained=meta-llama/Llama-3.1-8B-Instruct,dtype=bfloat16",
      "tasks": ["ceval-valid"],
      "num_fewshot": 5,
      "apply_chat_template": true,
      "kv": { "pipeline": [] },
      "output_path": "llama3_test/ceval_dense.json"
    },
    {
      "name": "llama31_gsm8k_dense",
      "model_args": "pretrained=meta-llama/Llama-3.1-8B-Instruct,dtype=bfloat16",
      "tasks": ["gsm8k"],
      "samples": "@gsm8k_samples_profile20pct.json",
      "num_fewshot": 0,
      "gen_kwargs": {"max_gen_toks": 512},
      "apply_chat_template": true,
      "kv": { "pipeline": [] },
      "output_path": "llama3_test/gsm8k_20pct_dense.json"
    },
    {
      "name": "llama31_humaneval_instruct_dense",
      "model_args": "pretrained=meta-llama/Llama-3.1-8B-Instruct,dtype=bfloat16",
      "tasks": ["humaneval_instruct"],
      "num_fewshot": 0,
      "env": {"HF_ALLOW_CODE_EVAL": "1"},
      "confirm_run_unsafe_code": true,
      "apply_chat_template": true,
      "kv": { "pipeline": [] },
      "output_path": "llama3_test/humaneval_instruct_dense.json"
    },
    {
      "name": "llama31_ceval_sparsify48",
      "model_args": "pretrained=meta-llama/Llama-3.1-8B-Instruct,dtype=bfloat16",
      "tasks": ["ceval-valid"],
      "num_fewshot": 5,
      "apply_chat_template": true,
      "kv": {
        "pipeline": [
          { "method": "sparsify_nm", "n": 8, "m": 4, "k_layers": "all", "v_layers": "all" }
        ]
      },
      "output_path": "llama3_test/ceval_sparsify48.json"
    },
    {
      "name": "llama31_gsm8k_sparsify48",
      "model_args": "pretrained=meta-llama/Llama-3.1-8B-Instruct,dtype=bfloat16",
      "tasks": ["gsm8k"],
      "samples": "@gsm8k_samples_profile20pct.json",
      "num_fewshot": 0,
      "gen_kwargs": {"max_gen_toks": 512},
      "apply_chat_template": true,
      "kv": {
        "pipeline": [
          { "method": "sparsify_nm", "n": 8, "m": 4, "k_layers": "all", "v_layers": "all" }
        ]
      },
      "output_path": "llama3_test/gsm8k_20pct_sparsify48.json"
    },
    {
      "name": "llama31_humaneval_instruct_sparsify48",
      "model_args": "pretrained=meta-llama/Llama-3.1-8B-Instruct,dtype=bfloat16",
      "tasks": ["humaneval_instruct"],
      "num_fewshot": 0,
      "env": {"HF_ALLOW_CODE_EVAL": "1"},
      "confirm_run_unsafe_code": true,
      "apply_chat_template": true,
      "kv": {
        "pipeline": [
          { "method": "sparsify_nm", "n": 8, "m": 4, "k_layers": "all", "v_layers": "all" }
        ]
      },
      "output_path": "llama3_test/humaneval_instruct_sparsify48.json"
    },
    {
      "name": "qwen35_humaneval_instruct_dense",
      "model_args": "pretrained=Qwen/Qwen3.5-9B,dtype=bfloat16,enable_thinking=False",
      "tasks": ["humaneval_instruct"],
      "num_fewshot": 0,
