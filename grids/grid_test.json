      "gen_kwargs": {"max_gen_toks": 512},
      "apply_chat_template": true,
      "kv": {
        "pipeline": [
          { "method": "sparsify_nm", "n": 8, "m": 4, "k_layers": "all", "v_layers": "all" }
        ]
      },
      "output_path": "qwen_test/gsm8k_20pct_sparsify48.json"
    },
    {
      "name": "qwen35_ceval_sparsify48",
      "model_args": "pretrained=Qwen/Qwen3.5-9B,dtype=bfloat16,enable_thinking=False",
      "tasks": ["ceval-valid"],
      "num_fewshot": 5,
      "apply_chat_template": true,
      "kv": {
        "pipeline": [
