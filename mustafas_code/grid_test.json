    {
      "name": "llama31_ceval_baseline",
      "model_args": "pretrained=meta-llama/Llama-3.1-8B-Instruct,dtype=bfloat16",
      "tasks": ["ceval-valid"],
      "num_fewshot": 5,
      "apply_chat_template": true,
      "sparsity_4_to_8_enabled": false,
      "output_path": "llama3_test/ceval_baseline.json"
    },
    {
      "name": "llama31_ceval_sparse48",
