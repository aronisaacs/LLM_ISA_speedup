+++ b/ggml/include/ggml.h
@@ -430,7 +430,9 @@ extern "C" {
         GGML_TYPE_NVFP4   = 40, // NVFP4 (4 blocks, E4M3 scale)
         GGML_TYPE_Q1_0    = 41,
         GGML_TYPE_Q2_0    = 42,
-        GGML_TYPE_COUNT   = 43,
+        GGML_TYPE_VCK50   = 43, // vector-compressed key: half the RoPE pairs kept, plus a pair bitmask
+        GGML_TYPE_VCV50   = 44, // vector-compressed value: half the scalars kept, plus a bitmask
+        GGML_TYPE_COUNT   = 45,
     };
 
     // [TAG_GGML_PREC]
diff --git a/ggml/src/ggml-common.h b/ggml/src/ggml-common.h
index 1dbbe326d..3ac3761ff 100644
--- a/ggml/src/ggml-common.h
+++ b/ggml/src/ggml-common.h
@@ -191,6 +191,25 @@ typedef struct {
 } block_q2_0;
 static_assert(sizeof(block_q2_0) == sizeof(ggml_half) + QK2_0 / 4, "wrong q2_0 block size/padding");
 
+// Vector compression of one 128-wide K or V head vector: the largest-magnitude
+// entries are kept in their original order, and a bitmask (LSB first) marks them.
+// Keys keep RoPE pairs (2i, 2i+1), llama.cpp's rotation pairs, ranked by
+// x[2i]^2 + x[2i+1]^2, with one mask bit per pair. Values keep scalars by |x|.
+#define QKVC 128
+#define VCK50_KEEP_PAIRS 32
+typedef struct {
+    uint8_t   mask[QKVC / 16];            // one bit per pair
+    ggml_half vals[2 * VCK50_KEEP_PAIRS]; // kept pairs, in order
+} block_vck50;
+static_assert(sizeof(block_vck50) == QKVC / 16 + 4 * VCK50_KEEP_PAIRS, "wrong vck50 block size/padding");
+
+#define VCV50_KEEP 64
+typedef struct {
+    uint8_t   mask[QKVC / 8];             // one bit per scalar
+    ggml_half vals[VCV50_KEEP];           // kept scalars, in order
+} block_vcv50;
+static_assert(sizeof(block_vcv50) == QKVC / 8 + 2 * VCV50_KEEP, "wrong vcv50 block size/padding");
+
 #define QK4_0 32
 typedef struct {
     ggml_half d;           // delta
diff --git a/ggml/src/ggml-cpu/ggml-cpu.c b/ggml/src/ggml-cpu/ggml-cpu.c
index 8620c6c7a..0d05f67ef 100644
--- a/ggml/src/ggml-cpu/ggml-cpu.c
+++ b/ggml/src/ggml-cpu/ggml-cpu.c
@@ -237,6 +237,16 @@ static const struct ggml_type_traits_cpu type_traits_cpu[GGML_TYPE_COUNT] = {
         .vec_dot_type             = GGML_TYPE_Q8_0,
         .nrows                    = 1,
     },
+    [GGML_TYPE_VCK50] = {
+        .from_float               = quantize_row_vck50,
+        .vec_dot                  = ggml_vec_dot_vck50_f16,
+        .vec_dot_type             = GGML_TYPE_F16,
+        .nrows                    = 1,
+    },
+    [GGML_TYPE_VCV50] = {
+        .from_float               = quantize_row_vcv50,
+        .nrows                    = 1,
+    },
     [GGML_TYPE_Q4_0] = {
         .from_float               = quantize_row_q4_0,
         .vec_dot                  = ggml_vec_dot_q4_0_q8_0,
diff --git a/ggml/src/ggml-cpu/quants.c b/ggml/src/ggml-cpu/quants.c
index 5e36459f8..388290b26 100644
--- a/ggml/src/ggml-cpu/quants.c
+++ b/ggml/src/ggml-cpu/quants.c
@@ -30,6 +30,42 @@ void quantize_row_q2_0(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, in
     quantize_row_q2_0_ref(x, y, k);
 }
 
+void quantize_row_vck50(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t k) {
+    quantize_row_vck50_ref(x, y, k);
+}
+
+void quantize_row_vcv50(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t k) {
+    quantize_row_vcv50_ref(x, y, k);
+}
+
+// q.k over the kept pairs only: the dropped pairs are zero and contribute nothing.
+void ggml_vec_dot_vck50_f16(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc) {
+    assert(n % QKVC == 0);
+    assert(nrc == 1);
+    UNUSED(nrc);
+    UNUSED(bx);
+    UNUSED(by);
+    UNUSED(bs);
+
+    const block_vck50 * GGML_RESTRICT x = vx;
+    const ggml_fp16_t * GGML_RESTRICT y = vy;
+    const int nb = n / QKVC;
+
+    float sumf = 0.0f;
+    for (int i = 0; i < nb; i++) {
+        const ggml_fp16_t * yb = y + i*QKVC;
+        int o = 0;
+        for (int j = 0; j < QKVC / 2; ++j) {
+            if (x[i].mask[j / 8] & (1u << (j % 8))) {
+                sumf += GGML_CPU_FP16_TO_FP32(x[i].vals[o])     * GGML_CPU_FP16_TO_FP32(yb[2*j]);
+                sumf += GGML_CPU_FP16_TO_FP32(x[i].vals[o + 1]) * GGML_CPU_FP16_TO_FP32(yb[2*j + 1]);
+                o += 2;
+            }
+        }
+    }
+    *s = sumf;
+}
+
 void quantize_row_q4_0(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t k) {
     quantize_row_q4_0_ref(x, y, k);
 }
diff --git a/ggml/src/ggml-cpu/quants.h b/ggml/src/ggml-cpu/quants.h
index 93ea7eeff..ef12e65e0 100644
--- a/ggml/src/ggml-cpu/quants.h
+++ b/ggml/src/ggml-cpu/quants.h
@@ -14,6 +14,9 @@ extern "C" {
 // Quantization
 void quantize_row_q1_0(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t k);
 void quantize_row_q2_0(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t k);
+void quantize_row_vck50(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t k);
+void quantize_row_vcv50(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t k);
+void ggml_vec_dot_vck50_f16(int n, float * GGML_RESTRICT s, size_t bs, const void * GGML_RESTRICT vx, size_t bx, const void * GGML_RESTRICT vy, size_t by, int nrc);
 void quantize_row_q4_0(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t k);
 void quantize_row_q4_1(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t k);
 void quantize_row_q5_0(const float * GGML_RESTRICT x, void * GGML_RESTRICT y, int64_t k);
diff --git a/ggml/src/ggml-quants.c b/ggml/src/ggml-quants.c
index 7750a72ce..51c7ab424 100644
--- a/ggml/src/ggml-quants.c
+++ b/ggml/src/ggml-quants.c
@@ -5509,6 +5509,28 @@ bool ggml_validate_row_data(enum ggml_type type, const void * data, size_t nbyte
             {
                 VALIDATE_ROW_DATA_D_F16_IMPL(block_q2_0, data, nb);
             } break;
+        case GGML_TYPE_VCK50:
+            {
+                const block_vck50 * q = (const block_vck50 *) data;
+                for (size_t i = 0; i < nb; ++i) {
+                    for (int j = 0; j < 2*VCK50_KEEP_PAIRS; ++j) {
+                        if (!validate_fp16(q[i].vals[j], i)) {
+                            return false;
+                        }
+                    }
+                }
+            } break;
+        case GGML_TYPE_VCV50:
+            {
+                const block_vcv50 * q = (const block_vcv50 *) data;
+                for (size_t i = 0; i < nb; ++i) {
+                    for (int j = 0; j < VCV50_KEEP; ++j) {
+                        if (!validate_fp16(q[i].vals[j], i)) {
+                            return false;
+                        }
+                    }
+                }
+            } break;
         case GGML_TYPE_Q4_0:
             {
                 VALIDATE_ROW_DATA_D_F16_IMPL(block_q4_0, data, nb);
@@ -5637,3 +5659,117 @@ bool ggml_validate_row_data(enum ggml_type type, const void * data, size_t nbyte
 
     return true;
 }
+
+// ====================== vector compression (vck50 / vcv50) ======================
+//
+// Mirrors compression_topics/vector/algorithms/vector_compress.py (values) and
+// vector_compress_pair.py (keys) in LLM_ISA_speedup. Keys there use the
+// transformers half-split layout, pairs (i, i + 64); llama.cpp's GGUF keys use
+// adjacent pairs (2i, 2i + 1). The kept set is the same; only positions differ.
+
+typedef struct {
+    float score;
+    int   index;
+} vc_entry;
+
+// Larger score first; on a tie the lower index first.
+static int vc_entry_cmp(const void * a, const void * b) {
+    const vc_entry * x = (const vc_entry *) a;
+    const vc_entry * y = (const vc_entry *) b;
+    if (x->score != y->score) {
+        return x->score > y->score ? -1 : 1;
+    }
+    return x->index - y->index;
+}
+
+// Sets bit j of mask (LSB first) for the n_keep largest of n scores.
+static void vc_top_mask(const float * score, int n, int n_keep, uint8_t * mask) {
+    vc_entry e[QKVC];
+    assert(n <= QKVC);
+    for (int j = 0; j < n; ++j) {
+        e[j].score = score[j];
+        e[j].index = j;
+    }
+    qsort(e, n, sizeof(vc_entry), vc_entry_cmp);
+    memset(mask, 0, (n + 7) / 8);
+    for (int r = 0; r < n_keep; ++r) {
+        mask[e[r].index / 8] |= (uint8_t) (1u << (e[r].index % 8));
+    }
+}
+
+void quantize_row_vck50_ref(const float * GGML_RESTRICT x, block_vck50 * GGML_RESTRICT y, int64_t k) {
+    assert(k % QKVC == 0);
+    const int64_t nb = k / QKVC;
+
+    for (int64_t i = 0; i < nb; i++) {
+        const float * xb = x + i*QKVC;
+        float score[QKVC / 2];
+        for (int j = 0; j < QKVC / 2; ++j) {
+            score[j] = xb[2*j]*xb[2*j] + xb[2*j + 1]*xb[2*j + 1];
+        }
+        vc_top_mask(score, QKVC / 2, VCK50_KEEP_PAIRS, y[i].mask);
+
+        int o = 0;
+        for (int j = 0; j < QKVC / 2; ++j) {
+            if (y[i].mask[j / 8] & (1u << (j % 8))) {
+                y[i].vals[o++] = GGML_FP32_TO_FP16(xb[2*j]);
+                y[i].vals[o++] = GGML_FP32_TO_FP16(xb[2*j + 1]);
+            }
+        }
+        assert(o == 2*VCK50_KEEP_PAIRS);
+    }
+}
+
+void dequantize_row_vck50(const block_vck50 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    assert(k % QKVC == 0);
+    const int64_t nb = k / QKVC;
+
+    for (int64_t i = 0; i < nb; i++) {
+        float * yb = y + i*QKVC;
+        int o = 0;
+        for (int j = 0; j < QKVC / 2; ++j) {
+            if (x[i].mask[j / 8] & (1u << (j % 8))) {
+                yb[2*j]     = GGML_FP16_TO_FP32(x[i].vals[o++]);
+                yb[2*j + 1] = GGML_FP16_TO_FP32(x[i].vals[o++]);
+            } else {
+                yb[2*j]     = 0.0f;
+                yb[2*j + 1] = 0.0f;
+            }
+        }
+    }
+}
+
+void quantize_row_vcv50_ref(const float * GGML_RESTRICT x, block_vcv50 * GGML_RESTRICT y, int64_t k) {
+    assert(k % QKVC == 0);
+    const int64_t nb = k / QKVC;
+
+    for (int64_t i = 0; i < nb; i++) {
+        const float * xb = x + i*QKVC;
+        float score[QKVC];
+        for (int j = 0; j < QKVC; ++j) {
+            score[j] = fabsf(xb[j]);
+        }
+        vc_top_mask(score, QKVC, VCV50_KEEP, y[i].mask);
+
+        int o = 0;
+        for (int j = 0; j < QKVC; ++j) {
+            if (y[i].mask[j / 8] & (1u << (j % 8))) {
+                y[i].vals[o++] = GGML_FP32_TO_FP16(xb[j]);
+            }
+        }
+        assert(o == VCV50_KEEP);
+    }
+}
+
+void dequantize_row_vcv50(const block_vcv50 * GGML_RESTRICT x, float * GGML_RESTRICT y, int64_t k) {
+    assert(k % QKVC == 0);
+    const int64_t nb = k / QKVC;
+
+    for (int64_t i = 0; i < nb; i++) {
+        float * yb = y + i*QKVC;
+        int o = 0;
+        for (int j = 0; j < QKVC; ++j) {
+            yb[j] = (x[i].mask[j / 8] & (1u << (j % 8))) ? GGML_FP16_TO_FP32(x[i].vals[o++]) : 0.0f;
+        }
+    }
+}
